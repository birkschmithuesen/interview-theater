# Beispielkonfiguration fuer einen Bot-Prozess. Kopieren nach betrieb/<name>.env,
# ausfuellen, Rechte auf 600 setzen. Die echten .env-Dateien sind von .gitignore
# erfasst und gehoeren NIE ins Repository.
#
# Laden:  set -a; . ./betrieb/gruppe1.env; set +a

# --- Telegram -------------------------------------------------------------
# Ein eigener Bot je Kleingruppe. Bei BotFather ZWINGEND den Privacy Mode
# ausschalten, sonst erreichen Sprachnachrichten den Bot nie.
IT_BOT_TOKEN=123456:AA...
IT_BOT_NAME=gruppe1

# --- Ablage ---------------------------------------------------------------
IT_DB=./interview_theater.db
IT_AUDIO=./audio

# --- Sprachmodell (Infomaniak, OpenAI-kompatibel) -------------------------
# ACHTUNG, Stolperfalle: Die VOLLE URL inklusive /chat/completions eintragen.
# Der Code haengt nichts an. Mit .../openai/v1 allein kommt HTTP 404.
IT_LLM_URL=https://api.infomaniak.com/2/ai/PRODUKT-ID/openai/v1/chat/completions
IT_LLM_KEY=...
IT_LLM_MODELL=moonshotai/Kimi-K2.6

# Modell fuer Absichtserkennung und Journal. Optional -- ohne Angabe gilt der
# Vorgabewert unten. Gemessen: gemma trifft hier deutlich besser als Kimi
# (0 Falsch-Positive bei 25 Negativfaellen), hat aber rund 28 s Kaltstart.
# Der Bot laeuft beim Start selbst warm, das muss niemand von Hand tun.
IT_MODELL_ERKENNER=google/gemma-4-31B-it

# --- Spracherkennung (Whisper) --------------------------------------------
# Nur Basis und Produkt-ID; die Pfade baut der Code selbst zusammen. Whisper
# liegt unter /1/ai/<produkt>/..., NICHT unter /2/.../openai/v1/ (dort 404).
IT_STT_BASIS=https://api.infomaniak.com
IT_STT_PRODUKT=PRODUKT-ID

# --- Weboberflaeche -------------------------------------------------------
# Oeffentliche Basis-URL der Leseansicht. Der Bot nennt daraus den Link
# /g/<token> in der Begruessung und in /stand. Leer lassen = kein Link.
IT_WEB_URL=https://lab.artesmobiles.art/theatersoap

# --- Szenen-Aufruf -----------------------------------------------------
# infomaniak (Vorgabe): Kimi K2.6 mit Reasoning, Daten bleiben in der Schweiz.
# claude: Opus ueber den lokalen Proxy hermes-anthropic-proxy.service
#         (127.0.0.1:28764, Anthropic-Messages-Format, Abo, kein Key noetig).
#         Nur dieser eine Aufruf geht in die USA; die Gruppe bekommt vor jeder
#         Szene die Warnung. Gemessen 05.09.2026: Opus mit Abstand besser.
IT_SZENE_ANBIETER=claude
# IT_SZENE_URL=http://127.0.0.1:28764/v1/messages
# IT_SZENE_MODELL=claude-opus-5

# --- Deckel, die ohne Neustart wirken sollen ------------------------------
# Beide sind Notschrauben fuer den Workshoptag und haben brauchbare
# Vorgabewerte -- eingetragen werden sie nur, wenn eine Messung dazu Anlass
# gibt (06.09.2026 nachgetragen: sie fehlten hier, obwohl der Code sie liest).
#
# Harte Zeichengrenze des Gespraechs-Nutzertexts (kontext.zeichengrenze,
# Vorgabe 24000). Darueber greift die Kuerzungsleiter Verlauf -> Journal ->
# Verdichtungen, Vorfall 'kontext_gekuerzt'.
# IT_PROMPT_ZEICHEN=24000
#
# Obergrenze fuer Systemanweisung + Koerper des Gespraechs-Prompts in
# Zeichen (kontext.gesamtgrenze, Vorgabe 60000); muss deutlich ueber der
# groessten Systemanweisung liegen (gemessen 33.676 Zeichen, Phase 2, siehe
# docs/kontext-3-5-kalibrierung.md), sonst kuerzt jeder Zug.
# IT_PROMPT_ZEICHEN_GESAMT=60000
#
# Token-Budget der EINGABE des Szenenlaufs (szene.token_budget), fuer
# Systemanweisung UND Nutzertext zusammen (seit 30.09.2026). Ohne Angabe
# rechnet der Code es je Anbieter aus: 126000 bei Claude, 37488 bei
# Infomaniak. Nur setzen, wenn ein Anbieter seine Grenzen aendert.
# IT_SZENE_TOKEN_MAX=

# --- Nur fuer den Webdienst, nicht fuer einen Bot-Prozess -----------------
# Diese beiden liest ausschliesslich `python -m interview_theater.web`; sie
# gehoeren in die Env der Web-Unit, nicht hierher. Hier stehen sie zur
# Vollstaendigkeit, damit die Liste der IT_-Variablen an einer Stelle steht.
# IT_WEB_BIND=127.0.0.1:8010     # 0.0.0.0 wird abgelehnt (kein Login!)
# IT_WEB_PREFIX=/theatersoap     # Praefix, unter dem nginx durchreicht

# --- Das Workshop-Profil (06.09.2026) -------------------------------------
# Welches Profil dieser Prozess faehrt (workshop/<name>/*.toml). Ohne die
# Variable gilt das eingebaute Vorgabeprofil -- und das ist bitgleich
# dasselbe wie IT_WORKSHOP=dortmund-2026. Siehe AGENTS.md, "Workshop-Profil".
# IT_WORKSHOP=dortmund-2026
#
# Wo die Profile liegen. Nur setzen, wenn das Verzeichnis nicht neben dem
# Paket steht (Tests tun das).
# IT_WORKSHOP_BASIS=

# --- Der Kanal (30.09.2026, Karte Padua A2) --------------------------------
# Womit diese Gruppe arbeitet: 'telegram' (Vorgabe) oder 'web'.
# Ohne die Variable ist alles wie vorher -- Telegram bleibt Plan B. Ein
# Tippfehler faellt NICHT still auf Telegram zurueck, der Start bricht ab.
IT_KANAL=telegram

# Nur im Web-Kanal: die eine Gruppe, die dieser Prozess bedient. Anlegen mit
#   IT_DB=... IT_WEB_URL=... python -m scripts.web_gruppe anlegen <bot_name>
# Das Skript gibt die chat_id, den Link fuer die Gruppe und die zwei
# Env-Zeilen (IT_KANAL=web, IT_WEB_CHAT_ID=...) aus. IT_BOT_TOKEN ist im
# Web-Kanal nicht noetig. Eine chat_id, die die Datenbank nicht kennt,
# bricht den Start ab (bot.baue_kanal).
# IT_WEB_CHAT_ID=7000000000001

# Wie lang ein Aufnahmesegment im Browser ist (Millisekunden, Vorgabe 45000).
# Jedes Segment ist ein eigener MediaRecorder-Lauf und damit eine
# vollstaendige Datei -- Netz weg oder Tab zu verliert hoechstens dieses eine
# Segment. ACHTUNG: an den Browser gibt den Wert der WEBSERVER weiter
# (web_chat._segment_ms liest ihn aus SEINER Umgebung) -- wer ihn aendern
# will, setzt ihn in der Env der Web-Unit. Nur im Test verkuerzt (tests/e2e).
# IT_WEB_SEGMENT_MS=45000
#
# Der Webserver legt Uploads unter IT_AUDIO/<chat_id>/web-eingang/ ab, der
# Web-Bot holt sie dort ab und verweigert jeden Pfad ausserhalb SEINES
# IT_AUDIO. Web-Unit und Web-Bots muessen deshalb auf dasselbe Verzeichnis
# zeigen (beide Units laufen im Repo-Verzeichnis, Vorgabe ./audio). Die
# Web-Unit setzt IT_AUDIO ausdruecklich (docs/interview-theater-web.service),
# speichert den Pfad absolut und nennt das Verzeichnis beim Start im Log.
