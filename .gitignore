.superpowers/
__pycache__/
*.egg-info/
.venv/
*.db*
audio/
betrieb/*.env

# --- Vertrauliches: NIE committen (Interviews von realen Personen) ---
.env
*.env
!*.env.beispiel
betrieb/
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
transkripte/
verdichtungen/
export/
*.ogg
*.oga
*.wav
*.mp3
*.m4a
tokens*.txt
*token*.json

# Prueflaeufe des Regressionskorpus: die Berichte enthalten vollstaendige
# Modellantworten und bleiben deshalb lokal. Der Korpus selbst (korpus/*.jsonl)
# ist frei erfunden und gehoert ins Repository.
korpus/berichte/*
!korpus/berichte/.gitkeep

# Simulationslaeufe: Transkript und Bericht enthalten vollstaendige
# Modellantworten und bleiben lokal. Eine Ausnahme: verlauf.jsonl -- die
# Kennzahlen je Lauf sind der Vergleichsmassstab zwischen zwei Prompt-Staenden
# und gehoeren deshalb ins Repository. Die Interviews selbst
# (simulation/interviews/) sind frei erfunden und ebenfalls versioniert.
simulation/laeufe/*
!simulation/laeufe/.gitkeep
# Ausnahme: die von Hand geschriebenen Auswertungen eines Lauftages
# (`<datum>-<set>.md` ohne Seed-Suffix, `<datum>-sammel.md`). Sie enthalten
# keine vollstaendigen Modellantworten, sondern Kennzahlen, das Richterurteil
# und die abgeleiteten Fixes -- genau das, was beim naechsten Umbau gebraucht
# wird. Die automatisch erzeugten Transkripte tragen immer ein Seed-Suffix
# (`…-tag1-gruppe1-1.md`) und bleiben ignoriert.
!simulation/laeufe/2026-09-06-tag1-gruppe1.md
!simulation/laeufe/2026-09-06-tag1-gruppe2.md
!simulation/laeufe/2026-09-06-tag1-gruppe3.md
!simulation/laeufe/2026-09-06-regie.md
!simulation/laeufe/2026-09-06-sammel.md
simulation/berichte/*
!simulation/berichte/.gitkeep
!simulation/berichte/verlauf.jsonl
!simulation/berichte/abnahme-p12-*.md
!simulation/berichte/sim-invarianten-2026-10-05.md

# Padua-Browserlauf (simulation/browser_lauf.py): Rohlaeufe sind gross
# (Screenshots je Schritt) und koennen Betriebsdetails zeigen -- nur Bericht
# + Kontaktbogen der Abnahme werden von Hand committet, nicht jeder Lauf.
simulation/browser_laeufe/

# Berichte der Dramaturgie-Pruefung (scripts/dramaturgie_pruefen.py): sie
# enthalten Belegzitate aus den Szenentexten der Gruppe und bleiben lokal.
docs/dramaturgie-berichte/*
!docs/dramaturgie-berichte/.gitkeep

# `.venv/` mit Schraegstrich trifft ein echtes venv-Verzeichnis (dieser
# Arbeitsbaum), aber nicht einen Symlink auf das venv im Hauptbaum, den
# andere Arbeitsbaeume noch verwenden koennen -- deshalb zusaetzlich ohne
# Schraegstrich.
.venv

# Zugangs-PDFs/QR-Codes je Gruppe (Karte Padua A6): tragen das Web-Token in
# der URL -- das Token IST das Login. NIE committen.
workshop/*/zugang/

# uv.lock: von `uv run` je Arbeitsbaum frisch erzeugt (gemessen 06.10.2026,
# t_f7770dc4 -- kein pyproject.toml-Unterschied, reine Werkzeug-Ausgabe),
# nicht im Hauptbaum verfolgt. Ein echter Abhaengigkeitswechsel gehoert ins
# Repository -- dann hier gezielt mit `git add -f` nachtragen.
uv.lock

# Begriffsboard-Inhaltsmessung (t_2b9d2cbe): Rohantworten der erfundenen Faelle
docs/begriffsboard-inhalt/roh/
